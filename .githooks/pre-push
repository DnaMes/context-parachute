#!/usr/bin/env bash
# pre-push — best-effort documentation sync on push.
#
# WHY pre-push AND NOT post-push: git has no post-push hook. Verified against
# git 2.55.0 — `man githooks` documents pre-push, post-merge, post-commit,
# post-receive and others, but nothing named post-push. A .githooks/post-push
# file is never executed; it is dead code that looks like working automation.
#
# Consequence: this runs BEFORE the remote is updated, so it records the SHAs
# that are about to be pushed. It is therefore strictly best-effort and MUST
# NEVER block a push — a documentation update is never a reason to lose work.
# Every side effect is guarded and the hook always exits 0.
#
# Installed via: git config core.hooksPath .githooks
# See: shared-skills/wiki.md

set -uo pipefail   # deliberately no -e

# Inside a linked worktree git exports GIT_DIR (in the main checkout it does not).
# Every `git -C <other dir>` below would then operate on THIS repository instead of
# the directory it names: the wiki sync committed a tree containing only Home.md
# onto the pushed branch (claude-setup#214). Nothing here needs the inherited
# values; discovery from the current directory works in both kinds of checkout.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

log() { printf '[pre-push] %s\n' "$*"; }

# git feeds "<local-ref> <local-sha> <remote-ref> <remote-sha>" on stdin.
# Drain it so the caller never blocks on an unread pipe.
pushed_refs=""
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [[ "${local_sha}" =~ ^0+$ ]] && continue          # branch deletion
    pushed_refs+="${local_ref#refs/heads/}@${local_sha:0:7} "
done || true

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# In a linked worktree the toplevel is the worktree directory, not the repository:
# name things after the main checkout so all worktrees of one repo share one cache.
common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    && repo_name="$(basename "$(dirname "${common_dir}")")" \
    || repo_name="$(basename "${repo_root}")"
[[ -n "${pushed_refs}" ]] || exit 0

# ---------------------------------------------------------------- Obsidian ---
# Only touches frontmatter `updated:` and appends to a "## Push Log" section.
# Never rewrites prose. Runs detached (see the end), never inside the push.
update_obsidian() {
    local marker="${repo_root}/.obsidian-doc"
    [[ -f "${marker}" ]] || { log "no .obsidian-doc marker, skipping vault update"; return 0; }

    local vault_dir vault_real index today shortlog home_real
    vault_dir="$(head -n1 "${marker}" | tr -d '\r')"
    vault_dir="${vault_dir/#\~/${HOME}}"
    [[ -d "${vault_dir}" ]] || { log "vault dir not found: ${vault_dir}"; return 0; }

    # The marker lives in the repo, so it is untrusted: write only inside $HOME, after
    # resolving symlinks and '..'. Anything else is refused, never written.
    vault_real="$(cd "${vault_dir}" && pwd -P)" || return 0
    home_real="$(cd "${HOME}" && pwd -P)" || return 0
    [[ "${vault_real}" == "${home_real}"/* ]] \
        || { log "vault dir outside HOME, refusing: ${vault_dir}"; return 0; }

    index="${vault_real}/index.md"
    [[ -f "${index}" && ! -L "${index}" ]] || { log "no index.md in vault, skipping"; return 0; }

    today="$(date +%F)"
    shortlog="$(git log -1 --pretty=format:'%h %s' 2>/dev/null)" || shortlog="(unknown)"

    # Update `updated:` only inside the frontmatter block (first --- ... ---).
    if awk -v today="${today}" '
        NR == 1 && $0 == "---" { in_fm = 1; print; next }
        in_fm && $0 == "---"   { in_fm = 0; print; next }
        in_fm && /^updated:/   { print "updated: " today; next }
        { print }
    ' "${index}" > "${index}.tmp" 2>/dev/null; then
        if ! mv "${index}.tmp" "${index}" 2>/dev/null; then
            rm -f "${index}.tmp"
            log "could not replace index.md, leaving it untouched"
            return 0
        fi
    else
        rm -f "${index}.tmp"
        log "could not update frontmatter, leaving index.md untouched"
        return 0
    fi

    grep -q '^## Push Log' "${index}" 2>/dev/null || printf '\n## Push Log\n' >> "${index}"
    printf -- '- %s — %s — %s\n' "${today}" "${pushed_refs% }" "${shortlog}" >> "${index}"
    log "vault index updated: ${index}"
}

# -------------------------------------------------------------- native wiki ---
# Both GitHub and Forgejo only create <repo>.wiki.git once a first page exists
# via the web UI. A failing push here means "wiki not initialised yet" and is
# skipped silently — that is expected, not an error.
sync_wiki() {
    local origin wiki_url
    origin="$(git remote get-url origin 2>/dev/null)" || { log "no origin remote"; return 0; }

    case "${origin}" in
        *github.com*|*[0-9].[0-9]*:*|ssh://*|https://*)
            wiki_url="${origin%.git}.wiki.git" ;;
        *) log "unrecognised remote, skipping wiki"; return 0 ;;
    esac

    # Deliberately OUTSIDE the repo: a git clone under .git/ is still a git
    # repo on disk, and repo scanners (tools/scan-repos.sh) report it as an
    # uncatalogued project. Keep the cache in XDG state, keyed by repo name and git dir.
    # Key on the common git dir (absolute path): same-named repos at other paths get
    # their own cache, worktrees of one repo share theirs. cksum is POSIX everywhere.
    local key_hash wiki_key wiki_dir
    key_hash="$(printf '%s' "${common_dir:-${repo_root}}" | cksum | cut -d' ' -f1)"
    wiki_key="${repo_name}-${key_hash}"
    wiki_dir="${state_dir}/${wiki_key}"
    if [[ ! -d "${wiki_dir}/.git" ]]; then
        # No rm on failure: git removes the directory it created when a clone fails,
        # and a cache that already exists is never touched.
        GIT_TERMINAL_PROMPT=0 timeout 120 git clone --quiet --depth 1 "${wiki_url}" "${wiki_dir}" \
            </dev/null >/dev/null 2>&1 || {
            log "wiki not initialised or unreachable, skipping: ${wiki_url}"
            return 0
        }
    fi

    local home_page="${wiki_dir}/Home.md"
    [[ -f "${home_page}" ]] || printf '# %s\n' "${repo_name}" > "${home_page}"

    local now; now="$(date +%F)"
    grep -q '^## Push Log' "${home_page}" 2>/dev/null || printf '\n## Push Log\n' >> "${home_page}"
    printf -- '- %s — %s\n' "${now}" "${pushed_refs% }" >> "${home_page}"

    # Only Home.md is ever staged and committed: a stray file in the cache stays out.
    git -C "${wiki_dir}" add -- Home.md >/dev/null 2>&1 || return 0
    git -C "${wiki_dir}" diff --cached --quiet -- Home.md 2>/dev/null && { log "wiki already current"; return 0; }
    git -C "${wiki_dir}" commit --quiet -m "docs: sync from ${repo_name} push" -- Home.md >/dev/null 2>&1 || return 0
    if GIT_TERMINAL_PROMPT=0 timeout 120 git -C "${wiki_dir}" push --quiet </dev/null >/dev/null 2>&1; then
        log "wiki updated: ${wiki_url}"
    else
        log "wiki push failed (credentials or not initialised), skipping"
    fi
}

# ------------------------------------------------------------ detached run ---
# The sync outlives the hook: git returns at once, and the work runs in the background
# with its output in a log, never in git's pipes. One lock serialises concurrent pushes,
# because every repo's vault index and wiki cache are shared state. Without flock
# (not on stock macOS) nothing is synced rather than written unlocked.
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/wiki-sync"
command -v flock >/dev/null 2>&1 || { log "flock not found, skipping doc sync"; exit 0; }
mkdir -p "${state_dir}" 2>/dev/null || exit 0
(
    exec 9>>"${state_dir}/sync.lock"
    flock 9
    update_obsidian || log "vault update failed, continuing"
    sync_wiki       || log "wiki sync failed, continuing"
    log "sync finished: ${repo_name}"
) </dev/null >>"${state_dir}/pre-push.log" 2>&1 &

exit 0   # never block the push
